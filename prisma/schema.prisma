generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RepositoryRole {
  OWNER
  ADMIN
  VIEWER
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ReviewStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewTrigger {
  WEBHOOK
  MANUAL
  RETRY
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  PENDING
  PUBLISHED
  SUPPRESSED
  FAILED
}

enum DiffSide {
  LEFT
  RIGHT
}

enum ReviewJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum PublicationStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
}

enum PublicationKind {
  GITHUB_REVIEW
}

enum RepositoryIndexStatus {
  IDLE
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum RepositoryIndexJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookDeliveryStatus {
  RECEIVED
  ENQUEUED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  githubUserId BigInt   @unique
  githubLogin  String   @unique
  email        String?  @unique
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  installedGitHubApps GitHubInstallation[] @relation("InstallationCreator")
  repositoryMemberships RepositoryMembership[]
}

model GitHubInstallation {
  id                   String   @id @default(cuid())
  githubInstallationId BigInt   @unique
  accountLogin         String
  accountType          String
  installedByUserId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  suspendedAt          DateTime?

  installedByUser User?        @relation("InstallationCreator", fields: [installedByUserId], references: [id], onDelete: SetNull)
  repositories    Repository[]

  @@index([installedByUserId])
}

model Repository {
  id                 String   @id @default(cuid())
  installationId     String
  githubRepositoryId BigInt   @unique
  fullName           String   @unique
  ownerLogin         String
  name               String
  defaultBranch      String
  isEnabled          Boolean  @default(true)
  isArchived         Boolean  @default(false)
  reviewSettings     Json?
  lastIndexedAt      DateTime?
  lastIndexAttemptAt DateTime?
  lastIndexError     String?  @db.Text
  indexStatus        RepositoryIndexStatus @default(IDLE)
  indexEmbeddingModel String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  installation GitHubInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  memberships  RepositoryMembership[]
  documents    RepositoryDocument[]
  indexJobs    RepositoryIndexJob[]
  pullRequests PullRequest[]

  @@index([installationId])
}

model RepositoryDocument {
  id                  String   @id @default(cuid())
  repositoryId        String
  path                String
  branch              String
  contentSha          String
  chunkIndex          Int
  content             String   @db.Text
  embeddingModel      String
  embeddingDimensions Int
  embedding           Unsupported("vector(1536)")
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, path, branch, contentSha, chunkIndex])
  @@index([repositoryId, branch, path])
}

model RepositoryMembership {
  id           String         @id @default(cuid())
  userId       String
  repositoryId String
  role         RepositoryRole @default(VIEWER)
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

model PullRequest {
  id                  String           @id @default(cuid())
  repositoryId        String
  githubPullRequestId BigInt           @unique
  number              Int
  title               String
  body                String?          @db.Text
  authorGithubLogin   String
  authorGithubUserId  BigInt?
  state               PullRequestState @default(OPEN)
  isDraft             Boolean          @default(false)
  baseBranch          String
  baseSha             String
  headBranch          String
  headSha             String
  githubCreatedAt     DateTime
  githubUpdatedAt     DateTime
  mergedAt            DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    Review[]

  @@unique([repositoryId, number])
  @@index([repositoryId, state, githubUpdatedAt])
}

model Review {
  id             String        @id @default(cuid())
  pullRequestId  String
  githubReviewId BigInt?       @unique
  headSha        String
  status         ReviewStatus  @default(QUEUED)
  trigger        ReviewTrigger @default(WEBHOOK)
  riskScore      Int?
  summary        String?       @db.Text
  modelName      String?
  promptVersion  String?
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  pullRequest PullRequest    @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  findings    Finding[]
  metrics     ReviewMetrics?
  publication PublicationOutbox?

  @@unique([pullRequestId, headSha])
  @@index([pullRequestId, createdAt])
  @@index([status, createdAt])
}

model Finding {
  id                   String          @id @default(cuid())
  reviewId             String
  githubCommentId      BigInt?         @unique
  fingerprint          String
  path                 String
  startLine            Int?
  endLine              Int?
  side                 DiffSide?
  severity             FindingSeverity
  category             String
  confidence           Decimal         @db.Decimal(3, 2)
  title                String
  rationale            String          @db.Text
  suggestedFix         String?         @db.Text
  evidence             Json?
  status               FindingStatus   @default(PENDING)
  publicationOutboxId  String?
  publishedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  review             Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  publicationOutbox  PublicationOutbox? @relation(fields: [publicationOutboxId], references: [id], onDelete: SetNull)

  @@unique([reviewId, fingerprint])
  @@index([reviewId, status, severity])
  @@index([publicationOutboxId, status])
}

model PublicationOutbox {
  id                 String            @id @default(cuid())
  reviewId           String            @unique
  kind               PublicationKind   @default(GITHUB_REVIEW)
  idempotencyKey     String            @unique
  payload            Json
  status             PublicationStatus @default(QUEUED)
  attempts           Int               @default(0)
  runAfter           DateTime          @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  leaseExpiresAt     DateTime?
  lastError          String?           @db.Text
  githubReviewId     BigInt?           @unique
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([status, runAfter])
  @@index([status, leaseExpiresAt])
}

model ReviewMetrics {
  id                     String   @id @default(cuid())
  reviewId               String   @unique
  inputTokens            Int      @default(0)
  outputTokens           Int      @default(0)
  embeddingInputTokens   Int      @default(0)
  totalTokens            Int      @default(0)
  estimatedCostUsd       Decimal  @default(0) @db.Decimal(12, 6)
  modelCallCount         Int      @default(0)
  filesChanged           Int      @default(0)
  filesAnalyzed          Int      @default(0)
  commentsPublished      Int      @default(0)
  durationMs             Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model WebhookDelivery {
  id               String                @id @default(cuid())
  githubDeliveryId String                @unique
  eventName        String
  action           String?
  payloadHash      String
  status           WebhookDeliveryStatus @default(RECEIVED)
  reviewJobId      String?
  receivedAt       DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  reviewJob ReviewJob? @relation(fields: [reviewJobId], references: [id], onDelete: SetNull)

  @@index([reviewJobId])
}

model ReviewJob {
  id                    String          @id @default(cuid())
  installationGithubId  BigInt
  repositoryGithubId    BigInt
  owner                 String
  repositoryName        String
  pullRequestNumber     Int
  headSha               String
  status                ReviewJobStatus @default(QUEUED)
  attempts              Int             @default(0)
  runAfter              DateTime        @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  leaseExpiresAt        DateTime?
  lastHeartbeatAt       DateTime?
  failureCode           String?
  lastError             String?         @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  deliveries WebhookDelivery[]

  @@unique([repositoryGithubId, pullRequestNumber, headSha])
  @@index([status, runAfter])
  @@index([status, leaseExpiresAt])
}

model RepositoryIndexJob {
  id                    String                   @id @default(cuid())
  repositoryId          String
  installationGithubId  BigInt
  owner                 String
  repositoryName        String
  branch                String
  force                 Boolean                  @default(false)
  status                RepositoryIndexJobStatus @default(QUEUED)
  attempts              Int                      @default(0)
  runAfter              DateTime                 @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  leaseExpiresAt        DateTime?
  lastHeartbeatAt       DateTime?
  failureCode           String?
  lastError             String?                  @db.Text
  startedAt             DateTime?
  completedAt           DateTime?
  indexedDocuments      Int?
  indexedChunks         Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, branch])
  @@index([status, runAfter])
  @@index([status, leaseExpiresAt])
}

model WebhookRateLimit {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
